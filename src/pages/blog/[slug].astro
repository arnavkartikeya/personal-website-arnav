---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, updated, tags, draft, cover, coverAlt } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date}
  tags={tags}
  image={cover?.src}
>
  {draft && <meta slot="head" name="robots" content="noindex" />}
  <article>
    <header class="mb-8 border-b border-rule pb-5">
      <h1 class="mb-2 font-serif text-[36.4px] leading-[1.13] font-normal text-ink-strong">{title}</h1>
      <p class="mb-3 text-[18.2px] leading-snug text-muted">{description}</p>
      <p class="font-sans text-[12.5px] text-faint">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <> · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {tags.length > 0 && <> · {tags.join(', ')}</>}
        {draft && <span class="ml-1 text-link">· draft (not published)</span>}
      </p>
    </header>

    {cover && <Image src={cover} alt={coverAlt ?? ''} class="mb-8 w-full rounded-sm" />}

    <div class="post-body">
      <Content />
    </div>
  </article>

  <p class="mt-16 font-sans text-[14px]">
    <a href={url('blog')} class="text-muted no-underline hover:text-link">← All posts</a>
  </p>
</BaseLayout>
