---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, url, type Post } from '../../lib/posts';
import { renderLexical } from '../../lib/lexical';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, description, date, updated, tags, draft, coverAlt } = post.data;

// Markdown/MDX posts render through Astro; editor posts through the Lexical renderer.
const md = post.collection === 'blog' ? await render(post) : null;
// Editor images are filenames in public/blog/<slug>/; full URLs pass through.
const asset = (file: string) => (/^([a-z]+:|\/)/i.test(file) ? file : url(`blog/${post.id}/${file}`));
const html =
  post.collection === 'editorPosts' ? await renderLexical(post.data.lexical as any, { image: asset }) : null;

const mdCover = post.collection === 'blog' ? post.data.cover : undefined;
const editorCover = post.collection === 'editorPosts' && post.data.cover ? asset(post.data.cover) : undefined;
const ogImage = mdCover?.src ?? editorCover;
---

<BaseLayout title={title} description={description} type="article" publishedTime={date} tags={tags} image={ogImage}>
  {draft && <meta slot="head" name="robots" content="noindex" />}
  {
    (mdCover || editorCover) && (
      <div slot="hero" class="post-cover" aria-hidden={coverAlt ? undefined : 'true'}>
        {mdCover ? (
          <Image src={mdCover} alt={coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="100vw" />
        ) : (
          <img src={editorCover} alt={coverAlt ?? ''} />
        )}
      </div>
    )
  }
  <article>
    <header class="mb-8 border-b border-rule pb-5">
      <h1 class="mb-2 font-serif text-[36.4px] leading-[1.13] font-normal text-ink-strong">{title}</h1>
      <p class="mb-3 text-[18.2px] leading-snug text-muted">{description}</p>
      <p class="font-sans text-[12.5px] text-faint">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <> · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {tags.length > 0 && <> · {tags.join(', ')}</>}
        {draft && <span class="ml-1 text-link">· draft (not published)</span>}
      </p>
    </header>

    <div class="post-body">
      {md && <md.Content />}
      {html !== null && <Fragment set:html={html} />}
    </div>
  </article>

  <p class="mt-16 font-sans text-[14px]">
    <a href={url('blog')} class="text-muted no-underline hover:text-link">← All posts</a>
  </p>
</BaseLayout>
