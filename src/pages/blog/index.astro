---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes on post-training, reinforcement learning, and interpretability.">
  <h1 class="mb-10 font-serif text-[36.4px] leading-tight font-normal text-ink-strong">Blog</h1>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-muted">Nothing here yet.</p>}
</BaseLayout>
