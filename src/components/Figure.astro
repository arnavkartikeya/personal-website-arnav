---
/** <Figure src={img} alt="…" caption="…" /> for MDX posts. Pass invertDark for black-on-white plots. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  width?: number;
  invertDark?: boolean;
}

const { src, alt, caption, width, invertDark = false } = Astro.props;
---

<figure class:list={{ 'invert-dark': invertDark }}>
  {typeof src === 'string' ? <img src={src} alt={alt} width={width} loading="lazy" /> : <Image src={src} alt={alt} width={width} />}
  {(caption || Astro.slots.has('default')) && <figcaption>{caption}<slot /></figcaption>}
</figure>
