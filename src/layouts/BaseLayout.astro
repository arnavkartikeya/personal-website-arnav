---
import '../styles/global.css';
import '../styles/article.css';
import { SITE } from '../site';
import { url } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for blog posts; adds Open Graph article metadata. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  image?: string;
}

const { title, description = SITE.description, type = 'website', publishedTime, tags = [], image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const section = path.startsWith('/blog') ? 'blog' : path === '/' ? 'about' : '';
const nav = [
  { href: url(''), label: 'About', key: 'about' },
  { href: url('blog'), label: 'Blog', key: 'blog' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Runs before paint so there's no flash of the wrong theme.
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="mx-auto w-full max-w-[682px] px-6 pt-10 pb-6">
      <nav class="flex items-baseline justify-between font-sans text-[14px]">
        <a href={url('')} class="font-serif text-[19px] text-ink-strong no-underline">{SITE.name}</a>
        <div class="flex items-baseline gap-5">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'no-underline transition-colors hover:text-link',
                  section === item.key ? 'text-ink-strong' : 'text-muted',
                ]}
                aria-current={section === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="theme-toggle"
            type="button"
            class="cursor-pointer text-muted transition-colors hover:text-link"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg class="block size-[15px] translate-y-[2px]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 15A7 7 0 1 0 8 1v14z" /><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 1a7 7 0 1 1 0 14A7 7 0 0 1 8 1z" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Full-width content above the column, e.g. a post's cover image. -->
    <slot name="hero" />

    <main class="relative mx-auto w-full max-w-[682px] flex-1 px-6 pb-24">
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-[682px] px-6 pb-10 font-sans text-[12.5px] text-faint">
      <div class="flex justify-between border-t border-rule pt-4">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <a href={url('rss.xml')} class="hover:text-link">RSS</a>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
